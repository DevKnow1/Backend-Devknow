# Base de datos
DB_URL=jdbc:postgresql://localhost:5432/devknow
DB_USER=devknow
DB_PASSWORD=change_me

# Seguridad (RNF-07): define valores propios; JWT_SECRET >= 32 caracteres
JWT_SECRET=change_me_to_a_long_random_secret_at_least_32_chars
ADMIN_EMAIL=admin@devknow.local
ADMIN_PASSWORD=change_me
CORS_ORIGINS=http://localhost:5173

# IA: mock (sin costo, solo desarrollo) | openai-compatible
# AI_PROVIDER=mock
# EMBEDDING_DIMENSION=768
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=http://localhost:11434/v1     # Ollama local (costo S/0)
# AI_API_KEY=your_api_key_here
# AI_EMBEDDING_MODEL=nomic-embed-text       # 768 dimensiones
# AI_CHAT_MODEL=llama3.1

# Gemini (capa gratuita): gemini-embedding-001 devuelve 3072 dimensiones por defecto y el indice HNSW
# de pgvector admite hasta 2000; AI_SEND_DIMENSIONS=true pide vectores de EMBEDDING_DIMENSION.
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_API_KEY=your_api_key_here
# AI_EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIMENSION=768
# AI_SEND_DIMENSIONS=true
# AI_CHAT_MODEL=gemini-3.5-flash-lite

AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.mistral.ai/v1
AI_API_KEY=your_api_key_here
AI_EMBEDDING_MODEL=mistral-embed
EMBEDDING_DIMENSION=1024
AI_SEND_DIMENSIONS=false
AI_CHAT_MODEL=mistral-small-latest